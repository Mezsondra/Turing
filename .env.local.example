# Server Configuration
PORT=3001

# Client Configuration
CLIENT_URL=http://localhost:5173

# AI Provider Configuration
# Options: 'gemini', 'openai', 'xai'
AI_PROVIDER=gemini

# Gemini API Configuration (if using Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# XAI API Configuration (if using XAI)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-1.5-flash

# Authentication - BOTH ARE REQUIRED, the server refuses to start without them.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_PASSWORD=

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# One price per plan, created in the Stripe dashboard.
# monthly/yearly are recurring prices; lifetime is a one-off price.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_LIFETIME=price_...

# Frontend Environment Variables (for Vite)
VITE_SERVER_URL=http://localhost:3001
VITE_ADSENSE_CLIENT_ID=ca-pub-your-adsense-client-id
