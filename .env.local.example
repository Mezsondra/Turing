# Server Configuration
PORT=3001

# Client Configuration
# In production this is your public URL, e.g. https://turing.example.com
CLIENT_URL=http://localhost:5173

# AI Provider Configuration
# Options: 'gemini', 'openai', 'xai'
AI_PROVIDER=gemini

# Gemini API Configuration (if using Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI API Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# XAI API Configuration (if using XAI)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-1.5-flash

# Authentication - BOTH ARE REQUIRED, the server refuses to start without them.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_PASSWORD=

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# One price per plan, created in the Stripe dashboard.
# monthly/yearly are recurring prices; lifetime is a one-off price.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_LIFETIME=price_...

# Frontend Environment Variables (baked into the bundle at `npm run build`,
# so change them BEFORE building and rebuild after any change).
# Leave VITE_SERVER_URL unset in production: the server serves the frontend
# itself, so same-origin is correct. Set it only if you host them separately.
# VITE_SERVER_URL=http://localhost:3001
VITE_ADSENSE_CLIENT_ID=ca-pub-your-adsense-client-id

# --- Mobile ads (AdMob, native builds only) ---
# Used by `npm run sync`, which builds with VITE_SERVER_URL pointed at
# production - the native app ships its assets inside the binary, so the web
# build's same-origin default would point at the phone itself.
# Leave this UNSET to keep Google's test ad unit. Serving or clicking your own
# live ads on a dev build gets the AdMob account suspended, and the ban follows
# the account rather than the app.
# The App ID (ca-app-pub-...~...) is separate and lives in the native config:
# ios/App/App/Info.plist (GADApplicationIdentifier) and
# android/app/src/main/AndroidManifest.xml. Both currently hold Google's test
# App ID - the SDK crashes on launch without one.
# VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxx/yyyyyyyy
# VITE_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxx/yyyyyyyy
#
# Rewarded video grants extra rounds, so the grant must not come from the
# client. In the AdMob console, open the rewarded ad unit -> Server-side
# verification, and set the callback URL to:
#   https://turing-test.app/api/ads/reward
# Without it the ad plays and nobody is ever credited.

# --- Passwordless sign-in (optional, but sign-in is degraded without them) ---

# Google Sign-In. Create an OAuth 2.0 Client ID of type "Web application" in
# Google Cloud Console, and add your site's origin to "Authorised JavaScript
# origins" (e.g. http://localhost:5173 for local work).
# Both variables take the SAME value. The server one verifies the token's
# audience; the VITE_ one renders the button and is baked in at build time, so
# the client must be rebuilt after changing it.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Email sign-in codes, sent through Resend (https://resend.com).
# EMAIL_FROM must be on a domain you have verified with Resend, or sends fail.
# With these unset, sign-in still works locally: the code is printed to the
# server log instead of emailed. Never ship it that way.
RESEND_API_KEY=
EMAIL_FROM="Turing Test Challenge <noreply@yourdomain.com>"
